# Builds cmd/api. Migrations are compiled into the binary via go:embed
# (see migrations/embed.go), so the runtime image needs nothing but the
# binary itself.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/api ./cmd/api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/api /usr/local/bin/api
EXPOSE 8080
USER nobody
ENTRYPOINT ["/usr/local/bin/api"]
