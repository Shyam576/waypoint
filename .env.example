# Copy this file to .env for local development. Never commit the real
# .env file (it is git-ignored).

# --- API ---
WAYPOINT_ENV=development
WAYPOINT_HTTP_ADDR=:8080
DATABASE_URL=postgres://waypoint:waypoint@localhost:5432/waypoint?sslmode=disable

# Session cookie behaviour. WAYPOINT_COOKIE_SECURE must be "true" in any
# environment served over HTTPS; keep it "false" for local HTTP dev only.
WAYPOINT_SESSION_COOKIE=waypoint_session
WAYPOINT_SESSION_TTL_HOURS=168
WAYPOINT_COOKIE_SECURE=false

# Origin the API will send Access-Control-Allow-Origin for (the Next.js
# dev server by default).
WAYPOINT_CORS_ORIGIN=http://localhost:3000

# Set this to any long random string to enable POST /api/v1/bootstrap/admin,
# which creates the first admin account. It only ever works once (while
# the users table is empty); leave it unset to disable the endpoint
# entirely once your admin account exists.
ADMIN_BOOTSTRAP_TOKEN=change-me-to-a-random-local-value

# --- web (Next.js) ---
# Server-side base URL the Next.js app proxies /api/* requests to.
WAYPOINT_API_URL=http://api:8080

# --- cmd/mcp ---
# A per-user token minted via POST /api/v1/users/{userID}/mcp-tokens.
WAYPOINT_MCP_TOKEN=
WAYPOINT_API_BASE_URL=http://localhost:8080
